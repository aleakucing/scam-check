# ==============================================================================
# ScamGuard AI — Environment Variables & Production Configuration
# IDwebhost AI HackFest 2026 | Cyber Security & Anti Scam
# ==============================================================================

# 1. AI Engine Configuration (Wajib untuk Analisis Multimodal Vision)
# Dapatkan Gemini API Key gratis di: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# (Opsional) OpenAI API Key jika menggunakan model cadangan OpenAI
OPENAI_API_KEY=

# 2. Server Configuration
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# 3. Security & Rate Limiting (PRD Section 43)
RATE_LIMIT_PER_MINUTE=60
