# ==============================================================================
# ScamGuard AI — Environment Variables & Production Configuration
# IDwebhost AI HackFest 2026 | Cyber Security & Anti Scam
# ==============================================================================

# 1. AI Engine Configuration (Wajib untuk Analisis Multimodal Vision)
# Dapatkan Gemini API Key gratis di: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 1b. Suara AI Gemini TTS (opsional — default sudah Bahasa Indonesia).
# Tanpa GEMINI_API_KEY, suara otomatis fallback ke speechSynthesis browser.
# Daftar voice: Kore, Charon, Fenrir, Puck, Zephyr, Leda, Aoede, dsb.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# (Opsional) OpenAI API Key jika menggunakan model cadangan OpenAI
OPENAI_API_KEY=

# 2. Server Configuration
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# 3. Security & Rate Limiting (PRD Section 43)
RATE_LIMIT_PER_MINUTE=60

# 4. Database (Production / hosting gratis tanpa VPS)
# Kosongkan untuk memakai file SQLite lokal (VPS atau development).
# Isi dengan connection string Postgres agar data tetap aman di platform
# yang filesystem-nya ephemeral (Render, Railway, dsb).
# Supabase: Project Settings -> Database -> Connection string -> URI (Pooler).
# Contoh: postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Hanya untuk Postgres lokal tanpa SSL (mis. docker compose).
# DATABASE_SSL=disable
